<div class="neurotom">

  <nav class="nav">
    <a href="/" class="brand">NEUROTOM<span>.</span></a>
    <div class="nav-links">
      <a href="#research">RESEARCH</a>
      <a href="#architecture">ARCHITECTURE</a>
      <a href="#about">ABOUT</a>
    </div>
    <span class="status"><i></i> INDEPENDENT RESEARCH</span>
  </nav>

  <main>
    <section class="hero">

      <div class="hero-content">
        <div class="eyebrow">
          <span>01</span> &nbsp; ARTIFICIAL INTELLIGENCE / NEUROSCIENCE
        </div>

        <h1>
          Understanding<br>
          <span>Intelligence.</span>
        </h1>

        <p class="hero-description">
          Exploring brain-inspired intelligence through computation,
          observation, memory and the architecture of intelligent systems.
        </p>

        <div class="hero-actions">
          <a href="#research" class="primary-btn">Explore research <span>↗</span></a>
          <a href="#architecture" class="secondary-btn">Our architecture</a>
        </div>

        <div class="hero-meta">
          <span>AI RESEARCH</span>
          <span>NEURAL SYSTEMS</span>
          <span>ROBOTICS</span>
        </div>
      </div>

      <div class="neural-visual">
        <div class="visual-label">NEURAL FIELD / 001</div>

        <svg viewBox="0 0 600 600" class="neural-svg"
             xmlns="http://www.w3.org/2000/svg">

          <defs>
            <radialGradient id="brainGlow">
              <stop offset="0%" stop-color="#7266ff" stop-opacity=".3"/>
              <stop offset="100%" stop-color="#7266ff" stop-opacity="0"/>
            </radialGradient>
            <filter id="glow">
              <feGaussianBlur stdDeviation="5" result="blur"/>
              <feMerge>
                <feMergeNode in="blur"/>
                <feMergeNode in="SourceGraphic"/>
              </feMerge>
            </filter>
          </defs>

          <circle cx="300" cy="300" r="240" fill="url(#brainGlow)"/>

          <g class="network-lines">
            <path d="M300 300 L180 170 L100 260 L210 390 L300 300"/>
            <path d="M300 300 L420 160 L500 260 L390 410 L300 300"/>
            <path d="M180 170 L300 90 L420 160"/>
            <path d="M100 260 L80 390 L210 480 L390 480 L500 260"/>
            <path d="M180 170 L210 390 L390 410 L420 160"/>
            <path d="M300 90 L300 300 L300 520"/>
            <path d="M80 390 L300 300 L500 260"/>
            <path d="M210 480 L300 300 L390 480"/>
          </g>

          <g class="network-nodes" filter="url(#glow)">
            <circle cx="300" cy="300" r="11" class="core"/>
            <circle cx="180" cy="170" r="6"/>
            <circle cx="420" cy="160" r="6"/>
            <circle cx="100" cy="260" r="5"/>
            <circle cx="500" cy="260" r="5"/>
            <circle cx="210" cy="390" r="6"/>
            <circle cx="390" cy="410" r="6"/>
            <circle cx="300" cy="90" r="5"/>
            <circle cx="80" cy="390" r="4"/>
            <circle cx="300" cy="520" r="5"/>
            <circle cx="210" cy="480" r="4"/>
            <circle cx="390" cy="480" r="4"/>
          </g>

          <circle cx="300" cy="300" r="165" class="orbit"/>
          <circle cx="300" cy="300" r="215" class="orbit orbit-two"/>
        </svg>

        <div class="visual-caption">
          <span>FIG. 001</span>
          <span>CONNECTED INTELLIGENCE</span>
        </div>
      </div>

    </section>

    <section id="research" class="research-section">
      <div class="section-heading">
        <span class="section-number">01 / RESEARCH</span>
        <h2>Beyond conventional computation.</h2>
        <p>
          Investigating new ways to understand, model and construct
          intelligent systems inspired by the human brain.
        </p>
      </div>

      <div class="research-grid">
        <article class="research-card">
          <span class="card-number">01</span>
          <div class="card-symbol">◎</div>
          <h3>Artificial Intelligence</h3>
          <p>Exploring architectures for adaptive and intelligent computation.</p>
        </article>

        <article class="research-card">
          <span class="card-number">02</span>
          <div class="card-symbol">⌘</div>
          <h3>Neuroscience</h3>
          <p>Studying memory, perception and the mechanisms of cognition.</p>
        </article>

        <article class="research-card">
          <span class="card-number">03</span>
          <div class="card-symbol">⌬</div>
          <h3>Robotics</h3>
          <p>Bringing intelligent architectures into physical machines.</p>
        </article>
      </div>
    </section>

    <section id="architecture" class="architecture-section">
      <span class="section-number">02 / ARCHITECTURE</span>
      <h2>Observe. Realize. Witness.</h2>
      <p>
        Exploring a computational architecture built around
        interconnected states of processing and observation.
      </p>

      <div class="architecture-flow">
        <div class="flow-node">
          <span>A</span>
          <h3>Observation</h3>
          <p>Processing information and memory.</p>
        </div>
        <div class="flow-arrow">→</div>
        <div class="flow-node">
          <span>B</span>
          <h3>Realization</h3>
          <p>Representing the state of computation.</p>
        </div>
        <div class="flow-arrow">→</div>
        <div class="flow-node">
          <span>C</span>
          <h3>Witness</h3>
          <p>Observing the realization itself.</p>
        </div>
      </div>
    </section>

    <section id="about" class="about-section">
      <span class="section-number">03 / ABOUT</span>
      <h2>Building toward a deeper understanding of intelligence.</h2>
      <p>
        Neurotom is an independent research initiative at the intersection
        of artificial intelligence, neuroscience and robotics.
      </p>
    </section>

  </main>

  <footer>
    <a href="/" class="brand">NEUROTOM<span>.</span></a>
    <span>INDEPENDENT RESEARCH · <%= Date.current.year %></span>
  </footer>

</div>